# Managed by ansible (roles/general). This host is the netdata
# streaming parent: it receives metrics streamed from the other
# ISUCON instances so they can all be viewed from one dashboard here.
[{{ netdata_stream_api_key }}]
    enabled = yes
    default history = 3600
    default memory mode = dbengine
    health enabled by default = auto
    allow from = 192.168.0.*
